# Every repository the A3 system is made of, at the state this one records.
#
# The point of the umbrella is that these belong together: a Core that
# answers an address the Motion of a different month never sends is not a
# system. What is recorded here is therefore not "the newest of each" but one
# coherent set -- see "A version is a tag" in README.md.
#
# https rather than ssh, so a clone works without a key.
#
# The website (a3-audio.github.io) is not here either, since 2026-10-04: it
# shows the newest state of the project, not one version of it.
#
# a3-motion-ui is deliberately NOT here. It is already a submodule of
# a3-motion, and a second gitlink to it would be a second place to keep in
# step -- which is the failure this whole file exists to prevent. The same
# goes, since 2026-10-31, for a3-mixer-ui (a3-mixer's), a3-beat-analyzer
# (a3-core's) and a3-stem-separator (a3-stemdeck's): each is pinned by the
# repository it belongs to. Every submodule path is its repository's name.

[submodule "a3-core"]
	path = a3-core
	url = https://github.com/a3-audio/a3-core

[submodule "a3-mixer"]
	path = a3-mixer
	url = https://github.com/a3-audio/a3-mixer

[submodule "a3-motion"]
	path = a3-motion
	url = https://github.com/a3-audio/a3-motion

[submodule "a3-doc"]
	path = a3-doc
	url = https://github.com/a3-audio/a3-doc

# The stem player: two decks of four stems, any one of them routable to aux
# and so onto a movement. Where a CDJ gives a stereo mix, this gives the parts.
[submodule "a3-stemdeck"]
	path = a3-stemdeck
	url = https://github.com/a3-audio/a3-stemdeck

# The pro-DJ: the set seen from the floor's centre, later the autopilot that
# conducts StemDeck and Motion through Core. Part of the release from v03.2.
[submodule "a3-prodj"]
	path = a3-prodj
	url = https://github.com/a3-audio/a3-prodj
