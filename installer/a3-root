"""The only thing the packages mode runs as root, with a fixed verb list.

    a3-root source <suite>      key + apt source for the public A3 archive
    a3-root install <pkg>...    apt-get update, install, hold (noninteractive)
    a3-root remove <pkg>...     unhold, apt-get remove (noninteractive)
    a3-root join-audio          add the calling user to the group audio
    a3-root install-release <dir>
                                a release's .debs from <dir>: SHA256SUMS signed
                                with the A3 key, every .deb listed in it, an A3
                                package for this machine; then install, hold

Package names must be A3 packages and nothing may look like an option: root
should never be a way to run arbitrary apt. install-release checks and installs
private root-owned copies of the files, so whoever owns <dir> cannot swap a
file between the checks and apt. Exit codes: 0 done, 2 refused,
otherwise the failing command's own.

Stdlib only and no import from the rest of the repository: this file is
copied alone. The archive values below repeat the ones in archive.py beside
it on purpose; a test keeps the two equal.
"""

import base64
import binascii
import hashlib
import os
import pwd
import re
import shutil
import stat
import subprocess
import sys
import tempfile
from pathlib import Path

ARCHIVE_URL = "https://a3-audio.github.io/a3-system"
KEYRING = Path("/usr/share/keyrings/a3-audio.gpg")
SOURCES = Path("/etc/apt/sources.list.d/a3-audio.sources")
SUITES = ("forky", "trixie")
A3_PACKAGES = ("a3-core", "a3-core-app", "stemdeck", "a3-desk",
               "a3-motion-ui", "beat-analyzer")
KEY_FILE = Path(__file__).resolve().parent / "keys" / "a3-audio-archive.asc"

RELEASE_SUMS = "SHA256SUMS"
RELEASE_SIGNATURE = "SHA256SUMS.asc"
SUMS_LINE = re.compile(r"^([0-9a-f]{64}) [ *](\S+)$")

REFUSED = 2


class Refused(Exception):
    pass


def sources_text(suite):
    return "\n".join([
        "Types: deb",
        f"URIs: {ARCHIVE_URL}",
        f"Suites: {suite}",
        "Components: main",
        f"Signed-By: {KEYRING}",
        "",
    ])


def crc24(data):
    crc = 0xB704CE
    for byte in data:
        crc ^= byte << 16
        for _ in range(8):
            crc <<= 1
            if crc & 0x1000000:
                crc ^= 0x864CFB
    return crc & 0xFFFFFF


def armor_lines(armored):
    """(base64 body, checksum text) between the BEGIN and END lines; the
    header lines (up to the first blank line) are dropped."""
    body, checksum = [], None
    inside = header_over = False
    for line in armored.splitlines():
        line = line.strip()
        if line.startswith("-----BEGIN"):
            inside, header_over = True, False
        elif line.startswith("-----END"):
            break
        elif not inside:
            continue
        elif not header_over:
            header_over = line == ""
        elif line.startswith("="):
            checksum = line[1:]
        elif line:
            body.append(line)
    return "".join(body), checksum


def dearmor(armored):
    """The binary key inside an ASCII-armored block, its CRC-24 checked."""
    body, checksum = armor_lines(armored)
    if checksum is None:
        raise Refused("The archive key has no armor checksum.")
    try:
        binary = base64.b64decode(body, validate=True)
        checksum_bytes = base64.b64decode(checksum, validate=True)
    except (binascii.Error, ValueError):
        raise Refused("The archive key is not valid ASCII armor.")
    if len(checksum_bytes) != 3:
        raise Refused("The archive key has a malformed armor checksum.")
    expected = int.from_bytes(checksum_bytes, "big")
    if not binary or crc24(binary) != expected:
        raise Refused("The archive key's checksum does not match.")
    return binary


def write_atomically(path, data, mode):
    """Temp file in the same folder, then rename: a half-written key never sits there."""
    path.parent.mkdir(parents=True, exist_ok=True)
    handle, temp = tempfile.mkstemp(dir=path.parent, prefix=f".{path.name}.")
    try:
        with os.fdopen(handle, "wb") as out:
            out.write(data)
        os.chmod(temp, mode)
        os.replace(temp, path)
    except BaseException:
        Path(temp).unlink(missing_ok=True)
        raise


def check_arguments(args):
    for arg in args:
        if arg.startswith("-"):
            raise Refused(f"{arg!r} looks like an option.")


def check_packages(packages):
    check_arguments(packages)
    if not packages:
        raise Refused("No packages named.")
    for package in packages:
        if package not in A3_PACKAGES:
            raise Refused(f"{package!r} is not an A3 package.")


def run_all(run, env, commands):
    for command in commands:
        code = run(command, env=env, check=False).returncode
        if code != 0:
            return code
    return 0


def snapshot(path):
    """(contents, mode) of `path`, or None when it is not there."""
    try:
        return path.read_bytes(), path.stat().st_mode & 0o7777
    except FileNotFoundError:
        return None


def restore(path, before):
    if before is None:
        path.unlink(missing_ok=True)
        return
    write_atomically(path, *before)


def noninteractive(env):
    """The caller's environment with apt's questions off: the installer
    preseeds every a3-core question before, and sudo's env_reset would drop
    a DEBIAN_FRONTEND the caller set anyway."""
    return {**env, "DEBIAN_FRONTEND": "noninteractive"}


def do_source(args, run, env, key_file, keyring, sources):
    check_arguments(args)
    if len(args) != 1 or args[0] not in SUITES:
        raise Refused(f"source takes one suite: {' or '.join(SUITES)}.")
    try:
        armored = key_file.read_text()
    except OSError as error:
        raise Refused(f"Cannot read the archive key: {error}")
    binary = dearmor(armored)
    # A source apt cannot update from breaks every later apt run on the
    # machine, so a failed update leaves both files as they were.
    before = {keyring: snapshot(keyring), sources: snapshot(sources)}
    try:
        write_atomically(keyring, binary, 0o644)
        write_atomically(sources, sources_text(args[0]).encode(), 0o644)
    except OSError as error:
        put_back(before, f"writing them failed ({error})")
        return 1
    code = run_all(run, env, [["apt-get", "update"]])
    if code != 0:
        put_back(before, "apt-get update failed")
    return code


def put_back(before, why):
    for path, previous in before.items():
        restore(path, previous)
    print(f"a3-root: {why}; the key and the source are as they were.", file=sys.stderr)


def do_install(packages, run, env):
    check_packages(packages)
    return run_all(run, noninteractive(env), [
        ["apt-get", "update"],
        ["apt-get", "install", "-y", "--allow-change-held-packages", *packages],
        ["apt-mark", "hold", *packages],
    ])


def do_remove(packages, run, env):
    check_packages(packages)
    return run_all(run, noninteractive(env), [
        ["apt-mark", "unhold", *packages],
        ["apt-get", "remove", "-y", *packages],
    ])


def release_folder(arg):
    folder = Path(arg)
    if not folder.is_absolute():
        raise Refused(f"{arg!r} is not an absolute path.")
    try:
        mode = os.lstat(folder).st_mode
    except OSError:
        raise Refused(f"{arg} is not there.")
    if not stat.S_ISDIR(mode):
        raise Refused(f"{arg} is not a folder (a symlink is not one either).")
    if mode & stat.S_IWOTH:
        raise Refused(f"{arg} is world-writable.")
    return folder


def release_debs(folder):
    """The .deb names in `folder`; refused if anything else lies there or
    the sums or their signature are missing."""
    debs, others = [], set()
    for entry in sorted(os.scandir(folder), key=lambda e: e.name):
        if entry.name.startswith("-"):
            raise Refused(f"{entry.name!r} looks like an option.")
        if entry.is_symlink():
            raise Refused(f"{entry.name} is a symlink.")
        if not entry.is_file(follow_symlinks=False):
            raise Refused(f"{entry.name} is not a regular file.")
        if entry.name in (RELEASE_SUMS, RELEASE_SIGNATURE):
            others.add(entry.name)
        elif entry.name.endswith(".deb"):
            debs.append(entry.name)
        else:
            raise Refused(f"{entry.name} is not a .deb.")
    for needed in (RELEASE_SUMS, RELEASE_SIGNATURE):
        if needed not in others:
            raise Refused(f"{folder} has no {needed}.")
    if not debs:
        raise Refused(f"{folder} holds no .deb.")
    return debs


def copy_private(source, target):
    """`source` copied to `target`, never through a symlink and only from a
    regular file; returns the copy's sha256."""
    digest = hashlib.sha256()
    try:
        handle = os.open(source, os.O_RDONLY | os.O_NOFOLLOW)
    except OSError as error:
        raise Refused(f"Cannot open {source.name}: {error.strerror}.")
    with os.fdopen(handle, "rb") as src:
        if not stat.S_ISREG(os.fstat(src.fileno()).st_mode):
            raise Refused(f"{source.name} is not a regular file.")
        with open(target, "xb") as out:
            for block in iter(lambda: src.read(1 << 20), b""):
                digest.update(block)
                out.write(block)
    os.chmod(target, 0o644)
    return digest.hexdigest()


def copy_release(folder, names, work):
    """The sums, their signature and the .debs copied into `work`; the
    .debs' sha256 by name."""
    try:
        for name in (RELEASE_SUMS, RELEASE_SIGNATURE):
            copy_private(folder / name, work / name)
        return {name: copy_private(folder / name, work / name) for name in names}
    except OSError as error:
        raise Refused(f"Copying the release failed: {error.strerror or error}.")


def parse_sums(text):
    sums = {}
    for line in text.splitlines():
        if not line.strip():
            continue
        found = SUMS_LINE.match(line)
        if not found:
            raise Refused(f"{RELEASE_SUMS} has a malformed line.")
        sums[found.group(2)] = found.group(1)
    return sums


def check_signature(run, env, keyring, work):
    gnupg = work / "gnupg"
    gnupg.mkdir(mode=0o700)
    done = run(["gpgv", "--homedir", str(gnupg), "--keyring", str(keyring),
                str(work / RELEASE_SIGNATURE), str(work / RELEASE_SUMS)],
               env=env, check=False, capture_output=True, text=True)
    if done.returncode != 0:
        raise Refused(f"{RELEASE_SIGNATURE} is not a good signature by the A3 key in {keyring}.")


def check_sums(sums, digests):
    for name, digest in digests.items():
        if name not in sums:
            raise Refused(f"{name} is not in {RELEASE_SUMS}.")
        if sums[name] != digest:
            raise Refused(f"{name} does not match its checksum in {RELEASE_SUMS}.")


def query(run, env, command):
    done = run(command, env=env, check=False, capture_output=True, text=True)
    return done.returncode, (done.stdout or "").strip()


def deb_field(run, env, deb, field):
    code, value = query(run, env, ["dpkg-deb", "-f", str(deb), field])
    if code != 0:
        raise Refused(f"{deb.name} is not a Debian package.")
    return value


def release_packages(run, env, debs):
    """{package: deb} after checking each is an A3 package for this machine."""
    code, machine = query(run, env, ["dpkg", "--print-architecture"])
    if code != 0 or not machine:
        raise Refused("dpkg does not name this machine's architecture.")
    packages = {}
    for deb in debs:
        package = deb_field(run, env, deb, "Package")
        arch = deb_field(run, env, deb, "Architecture")
        if package not in A3_PACKAGES:
            raise Refused(f"{deb.name}: {package!r} is not an A3 package.")
        if arch not in (machine, "all"):
            raise Refused(f"{deb.name} is for {arch}, this machine is {machine}.")
        if package in packages:
            raise Refused(f"{package} is in the release twice.")
        packages[package] = deb
    return packages


def do_install_release(args, run, env, keyring):
    check_arguments(args)
    if len(args) != 1:
        raise Refused("install-release takes one folder.")
    folder = release_folder(args[0])
    names = release_debs(folder)
    work = Path(tempfile.mkdtemp(prefix="a3-release-"))
    try:
        # apt reads local .debs as its own user: the copies are readable, root's alone to change.
        os.chmod(work, 0o755)
        digests = copy_release(folder, names, work)
        check_signature(run, env, keyring, work)
        check_sums(parse_sums((work / RELEASE_SUMS).read_text()), digests)
        packages = release_packages(run, env, [work / name for name in names])
        return run_all(run, noninteractive(env), [
            ["apt-get", "update"],
            ["apt-get", "install", "-y", "--allow-change-held-packages",
             *map(str, packages.values())],
            ["apt-mark", "hold", *packages],
        ])
    finally:
        shutil.rmtree(work, ignore_errors=True)


def calling_user(env):
    try:
        uid = int(env.get("PKEXEC_UID") or env.get("SUDO_UID"))
        name = pwd.getpwuid(uid).pw_name
    except (TypeError, ValueError, KeyError):
        raise Refused("no calling user")
    if uid == 0:
        raise Refused("no calling user")
    return name


def do_join_audio(args, run, env):
    check_arguments(args)
    if args:
        raise Refused("join-audio takes no arguments.")
    return run_all(run, env, [["usermod", "-aG", "audio", calling_user(env)]])


def main(argv, run=subprocess.run, env=os.environ,
         key_file=KEY_FILE, keyring=KEYRING, sources=SOURCES):
    verb, args = (argv[0], argv[1:]) if argv else (None, [])
    try:
        if verb == "source":
            return do_source(args, run, env, key_file, keyring, sources)
        if verb == "install":
            return do_install(args, run, env)
        if verb == "remove":
            return do_remove(args, run, env)
        if verb == "join-audio":
            return do_join_audio(args, run, env)
        if verb == "install-release":
            return do_install_release(args, run, env, keyring)
        raise Refused("verbs: source, install, remove, join-audio, install-release.")
    except Refused as why:
        print(f"a3-root: {why}", file=sys.stderr)
        return REFUSED


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
